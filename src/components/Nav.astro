---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  /** prefix for in-page anchors when the nav is used on a sub-page */
  base?: string;
}
const { base = '' } = Astro.props;

const links = [
  { href: `${base}#meni`, label: 'Meni' },
  { href: `${base}#pijace`, label: 'Pijače' },
  { href: `${base}#kontakt`, label: 'Kontakt' },
];
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="brand" href={base || '#top'} aria-label={`${site.fullName}, na vrh strani`}>
      <span class="brand__mark" aria-hidden="true">V</span>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__sub">Hitra kuhinja · Hrastnik</span>
      </span>
    </a>

    <nav class="nav__links" id="nav-links" aria-label="Glavna navigacija">
      <ul>
        {links.map((l) => (
          <li>
            <a class="nav__link" href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__actions">
      <a class="btn btn--primary btn--sm nav__call" href={site.phoneHref}>
        <Icon name="phone" />
        <span class="nav__call-text">{site.phone}</span>
        <span class="visually-hidden nav__call-sr">Pokliči {site.phone}</span>
      </a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links" data-nav-toggle>
        <Icon name="menu" class="nav__icon-open" />
        <Icon name="x" class="nav__icon-close" />
        <span class="visually-hidden">Odpri meni</span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    background: var(--accent);
    color: var(--on-accent);
    font: 800 1.35rem/1 var(--font-display);
    transition: transform 0.25s var(--ease-out);
  }

  .brand:hover .brand__mark {
    transform: rotate(-6deg);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand__name {
    font: 800 1.2rem/1.05 var(--font-display);
    letter-spacing: -0.02em;
  }

  .brand__sub {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .nav__links ul {
    display: flex;
    gap: var(--s-6);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-1);
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav__link:hover {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--mustard);
  }

  .nav__link:active {
    color: var(--accent);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .nav__call-sr {
    display: none;
  }

  .nav__toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav__toggle:hover {
    border-color: var(--ink);
  }

  .nav__toggle:active {
    background: var(--surface-alt);
  }

  .nav__toggle :global(svg) {
    width: 20px;
    height: 20px;
  }

  .nav__toggle :global(.nav__icon-close),
  .nav__toggle[aria-expanded='true'] :global(.nav__icon-open) {
    display: none;
  }

  .nav__toggle[aria-expanded='true'] :global(.nav__icon-close) {
    display: block;
  }

  @media (max-width: 759px) {
    .nav__toggle {
      display: grid;
    }

    .nav__links {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
      padding: var(--s-2) var(--gutter) var(--s-4);
      display: none;
    }

    .nav__links.is-open {
      display: block;
      animation: rise 0.25s var(--ease-out) both;
    }

    .nav__links ul {
      flex-direction: column;
      gap: 0;
    }

    .nav__link {
      width: 100%;
      min-height: 52px;
      font-size: 1.0625rem;
      border-bottom: 1px solid var(--line);
    }

    .nav__links li:last-child .nav__link {
      border-bottom: 0;
    }
  }

  @media (max-width: 479px) {
    .brand__sub {
      display: none;
    }

    .nav__call {
      width: 44px;
      padding: 0;
    }

    .nav__call-text {
      display: none;
    }

    .nav__call-sr {
      display: inline;
    }
  }
</style>
